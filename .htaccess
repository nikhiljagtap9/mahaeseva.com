    Header set Access-Control-Expose-Headers "Content-Type"
    Header set x-xhr-request "true"

    Header set Referrer-Policy: strict-origin-when-cross-origin
    Header always edit Set-Cookie (.*) "$1; secure; HTTPOnly; SameSite=Strict"

    Header set Content-Security-Policy:    "default-src 'self' https://s3.ap-south-1.amazonaws.com https://agent.jotform.com/ https://td.doubleclick.net/ https://bid.g.doubleclick.net https://*.tawk.to/ https://widget.whatshelp.io/ https://www.google.com/maps/ https://www.youtube.com https://s7.addthis.com https://staticxx.facebook.com https://checkout.razorpay.com https://api.razorpay.com/ https://www.googletagmanager.com/; frame-ancestors 'none'; connect-src 'self' https://events.jotform.com https://www.smatbot.com https://www.smatbot.com https://app.leadster.com.br https://stats.g.doubleclick.net https://va.tawk.to https://vs2.tawk.to https://vs28.tawk.to/ https://vs25.tawk.to/ https://static-v.tawk.to/ https://vs62.tawk.to/ https://vs70.tawk.to https://vs47.tawk.to/ https://*.tawk.to/ wss://*.tawk.to/ https://www.google-analytics.com https://www.google.com https://whatsapp.bhagwat.tech; script-src 'self' blob: data: 'unsafe-inline' 'unsafe-eval' https://cdn.jotfor.ms https://cdn.leadster.com.br https://cdn.leadster.com.br https://www.googleadservices.com https://js.jotform.com/actions.js https://googleads.g.doubleclick.net https://www.google.com https://static-v.tawk.to https://embed.tawk.to/ https://cdn.jsdelivr.net/ https://static.whatshelp.io/ www.google-analytics.com https://maps.googleapis.com https://maps.gstatic.com https://cdnjs.cloudflare.com https://code.responsivevoice.org https://connect.facebook.net https://m.addthisedge.com https://s7.addthis.com https://m.addthis.com https://graph.facebook.com https://widgets.pinterest.com https://www.linkedin.com https://www.googletagmanager.com  https://checkout.razorpay.com https://api.razorpay.com/; object-src 'none'; style-src 'self' 'unsafe-inline' https://cdn.jotfor.ms https://embed.tawk.to/ https://cdn.jsdelivr.net/ https://fonts.googleapis.com; img-src 'self' 'unsafe-inline' 'unsafe-eval' blob: data:   https://agent.jotform.com/01958a78d77971a9b7ae2882005b427b77b6/avatar-icon https://www.jotform.com/asset